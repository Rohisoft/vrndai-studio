# Copy this file to .env and fill in real values. All values here have
# sensible defaults (see apps/api/src/config/env.ts) except MONGODB_URI,
# ADMIN_USERNAME, and ADMIN_PASSWORD, which are required.

# Where ComfyUI's API is reachable. Default assumes ComfyUI running on the
# same machine. If ComfyUI runs on a remote GPU box, see the README for an
# SSH tunnel example instead of exposing it directly.
COMFYUI_BASE_URL=http://127.0.0.1:8188

# Only needed if your ComfyUI instance is behind its own auth.
COMFYUI_AUTH_TOKEN=

# true: skip ComfyUI entirely and return a bundled sample video instead --
# lets you run and test the whole app without a GPU. false: use the real
# ComfyUI client (not implemented until Phase 4).
COMFYUI_MOCK=true

PORT=3001
DATA_DIR=./data

# MongoDB Atlas connection string (job storage -- required, no local
# database anymore). Free tier: https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=

# Seeds the one super-admin account in MongoDB on first boot only -- once
# that user exists, these are ignored on every later boot (safe to leave
# set permanently). Required the very first time the app connects to an
# empty MongoDB.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# LLM provider for the AI Assistant + Stock Footage's script/keyword
# writing -- one of 'ollama' | 'groq' | 'gemini'. 'ollama' (default) needs a
# locally-running Ollama and only works when the server can reach it (e.g.
# local dev/Docker Compose) -- not an option on a host like Render with no
# machine of yours running Ollama. 'groq'/'gemini' are cloud APIs, only need
# their own API key set below; use one of those for a cloud deployment.
LLM_PROVIDER=ollama

# Ollama (only used when LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Groq (only used when LLM_PROVIDER=groq). Free key at https://console.groq.com/keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (only used when LLM_PROVIDER=gemini). Free key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Stock Footage engine -- Pexels API key for stock-clip search/download,
# used by the "Stock Footage (Pexels + Voiceover)" model. Get a free key at
# https://www.pexels.com/api/.
PEXELS_API_KEY=

# Where generated videos are stored -- 'local' (default) writes to
# DATA_DIR/videos, fine when the host has a persistent disk. 'google-drive'
# uploads to a Google account's Drive instead, so videos survive on a host
# with no persistent disk at all (e.g. Render's free tier). The four
# GOOGLE_DRIVE_* values below are only required when this is 'google-drive'.
VIDEO_STORAGE_PROVIDER=local

# OAuth client credentials from a Google Cloud project (APIs & Services ->
# Credentials -> OAuth client ID, type "Desktop app"), plus a refresh token
# obtained once via a one-time consent flow for the Drive account videos
# should be uploaded to -- see the README for exact steps.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional -- uploads go to this Drive folder's id when set, or the
# account's root "My Drive" otherwise.
GOOGLE_DRIVE_FOLDER_ID=
